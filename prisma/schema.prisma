generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("STAFF")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  department    String
  position      String
  status        String   @default("Active") // Active, Pending, Inactive
  joinDate      DateTime @default(now())
  documentCount Int      @default(0)
  documents     Document[]
  photo         String?

  // Ministry Categorization
  ministry           String?   // "Education", "Health", "Other"

  // Personal Details
  middleName         String?
  title              String?
  telephone          String?
  birthdate          DateTime?
  nin                String?
  gender             String?
  maritalStatus      String?
  stateOfOrigin      String?
  residentialAddress String?
  stateOfResidence   String?
  lga                String?
  profession         String?

  // Next of Kin
  nokName            String?
  nokRelationship    String?
  nokPhone           String?
  nokAddress         String?

  // Employment Record
  employmentId       String?
  serviceNo          String?
  fileNo             String?
  rank               String?
  organization       String?
  employmentType     String?
  probationPeriod    String?

  // Employment Details
  workLocation       String?
  dateOfFirstAppointment DateTime?
  salaryStructure    String?
  gradeLevel         String?
  step               String?
  cadre              String?

  // Banking and Pension
  bankName           String?
  accountNumber      String?
  nuban              String?
  pfaName            String?
  rsaPin             String?

  // Education
  educationalBackground String?
  certifications        String?
  dateOfGraduation      String?   // Date of Graduation

  // Verification
  ninVerified   Boolean  @default(false)
  ninData       Json?

  // Teacher CSV Import Fields (Ministry of Education)
  currentStation         String?
  dateOfLastPromotion    String?
  lgaOfOrigin            String?
  nationality            String?
  highestQualification   String?
  subjectTaught          String?
  bvn                    String?
  standardizedLga        String?
  standardizedSex        String?
  standardizedCadre      String?
  duplicateFlag          String?
  sharedIdentifierFlag   String?

  // Health Facilities CSV Import Fields (Ministry of Health)
  maidenName             String?   // Maiden Name
  areYouNigerian         String?   // Are you a Nigerian? (Yes/No)
  senatoralWardOfOrigin  String?   // Senatorial Ward of Origin
  wardOfOrigin           String?   // Ward of Origin
  country                String?   // Country
  mobileNo               String?   // Mobile Number (separate from telephone)
  permanentAddress       String?   // Permanent Address
  permanentState         String?   // Permanent State
  permanentLga           String?   // Permanent LGA

  // Health Professional Registration
  mdcnRegNo              String?   // MDCN/R/OTHERS - Medical Council Reg No
  professionalRegBody    String?   // e.g. MDCN, NMC, MLSCN, RRBN etc.
  professionalRegNo      String?   // Registration number with body
  licenseIssuanceDate    String?   // License/Certificate issuance date
  nurseSpecialization    String?   // e.g. Registered_Nurse, Other nurse specialization
  practitionerType       String?   // e.g. MEDICAL, Nursing & Midwifery

  // Health Facility Appointment Details
  appointmentType        String?   // e.g. PERMANENT, Contract, etc.
  presentPosting         String?   // Present posting (PRINCIPAL, PEO1, SN1, Staff Nurse, etc.)
  dateOfConfirmation     DateTime? // Date of Confirmation
  dateOfPresentAppointment DateTime? // Date of Present Appointment

  // Facility Info
  facilityName           String?   // e.g. Bambur General Hospital, Abubakar Barde First Referral
  facilityType           String?   // e.g. Secondary (hospital tier)
  branch                 String?   // Branch/Unit within facility

  // Submission / Import Metadata
  submissionId           String?   // uuid / submission id from source system
  validationStatus       String?   // validation field from source data
  importNotes            String?   // notes column from source data
  importSource           String?   // e.g. "submitted_via_web"
  importVersion          String?   // _version from source
  importTags             String?   // tags from source

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id          String   @id @default(uuid())
  name        String
  url         String?  // Storage path or URL
  type        String   // e.g., "ID", "Certificate", "OfferLetter"
  status      String   @default("Pending") // Pending, Verified, Rejected
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("System") // "Employee", "System", "Document"
  status      String   @default("Success") // "Success", "Pending", "Failed"
  createdAt   DateTime @default(now())
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  scope     String   @default("Global")
  files     SystemFile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemFile {
  id        String   @id @default(uuid())
  name      String
  size      Int
  type      String
  url       String?
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "view_employees"
  label       String   // e.g., "View Employees"
  module      String   // e.g., "Employees", "System", "Files"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Registration {
  id               String   @id @default(uuid())
  registrationNo   String   @unique
  bvn              String?
  nin              String?
  firstName        String
  lastName         String
  middleName       String?
  email            String
  phone            String?
  dateOfBirth      String?
  gender           String?
  address          String?
  department       String?
  designation      String?
  employeeId       String?
  grade            String?
  dateOfEmployment String?
  status           String   @default("Pending")
  ninVerified      Boolean  @default(false)
  photo            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
